# IncuBrix PS4 Distribution Service Configuration
# Copy this file to .env for custom configuration

# Service Configuration
HOST=0.0.0.0
PORT=8000
ENV=development
LOG_LEVEL=INFO

# Simulation & Safety
SIMULATION_MODE=true
MAX_RETRIES=5
REQUEST_TIMEOUT_SECONDS=10.0
IDEMPOTENCY_TTL_SECONDS=86400

# Database Settings
DATABASE_URL=sqlite:///./incubrix_ps4.db

# Storage Provider (local or s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_data
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=incubrix-artifacts
S3_REGION=us-east-1

# External AI Provider (swappable: mock, gemini, openai)
AI_PROVIDER=mock
AI_API_KEY=mock-key-for-local-test
AI_MODEL_NAME=mock-rules-engine-v1

# Webhook & Job Signing
WEBHOOK_HMAC_SECRET=incubrix-dev-secret-key-32chars-min

# Recertification Policy
RECERTIFICATION_INTERVAL_DAYS=30

# Mock Server Settings (for local e2e testing)
MOCK_SERVER_PORT=8080
MOCK_SERVER_HOST=http://localhost:8080
